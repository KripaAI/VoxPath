# Secrets: never commit API keys or database URLs
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / Next.js (frontend/.gitignore covers the rest)
node_modules/
.next/

# Runtime output, regenerated by the app
backend/logs/
backend/data/
# Eval run outputs: live answers and tool results; summaries go in Phoenix
backend/evals/results/
# Real users' messages copied from production traces: never commit
backend/evals/production_candidates.jsonl
tracing/data/
tracing/*.log

# Local backup of the original compiled files (not source)
original_pyc_backup/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
