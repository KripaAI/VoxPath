# Copy this file to .env and fill in real values. .env is git-ignored; this file is not.

# Required
OPENAI_API_KEY=
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=          # generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
RAPIDAPI_KEY=        # IRCTC railway lookups

# Optional (defaults shown)
# OPENAI_MODEL=gpt-4o-mini
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# REGISTRATION_OPEN=true           # false = no new sign-ups
# LOGIN_RATE_LIMIT=10/60           # requests/seconds per IP; 0 disables
# REGISTER_RATE_LIMIT=10/3600      # per IP
# RESET_RATE_LIMIT=10/900          # forgot-password requests and code attempts, per IP
# RESET_CODE_MINUTES=15            # how long a reset code works (shown in the backend window)
# CHAT_RATE_LIMIT=30/60            # per user
# CHAT_MAX_CHARS=4000              # longest chat message accepted (frontend matches 4000)
# MCP_HTTP_ENABLED=false           # true = expose every tool at /mcp to signed-in users
# MCP_RATE_LIMIT=30/60             # per user, when /mcp is enabled
# LOG_USER_CONTENT=true            # false = keep messages and emails out of logs
# PHOENIX_TRACING=false            # true = agent traces in Phoenix at http://localhost:6006
# PHOENIX_PROJECT_NAME=voxpath
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# NEWS_REFRESH_INTERVAL=300
# CRAWL_RUNS_KEEP_DAYS=30          # how long news_crawl_runs rows are kept
# LLM_PRICE_PER_MILLION_TOKENS=0.15,0.60   # input,output USD; overrides the built-in price list for cost_usd
# LOG_LEVEL=INFO
